# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/hotel_reservation?retryWrites=true&w=majority

# JWT Authentication Secrets (Must be at least 32 random characters in production)
JWT_SECRET=your_access_token_jwt_secret_min_32_characters_long_example
JWT_REFRESH_SECRET=your_refresh_token_jwt_secret_min_32_characters_long_example

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (Configures CORS and cross-origin cookies)
# Local: http://localhost:5173 | Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
